{
  "id": "MINOR_CS_2025-2026",
  "name": "Computer Science Minor (2025-2026)",


  "sets": {
    "cs_lower_core": ["CS210", "CS211", "CS212"],
    "math_discrete": ["MATH231", "MATH232"],
    "cs_upper_core_required": ["CS313"]
  },

  "requirements": [
    {
      "id": "cs_lower_core",
      "type": "all_of",
      "label": "Lower-Division Core",
      "from_set": "cs_lower_core",
      "must_be": { "grading_basis": "graded", "min_grade": "B-" }
    },

    {
      "id": "math_discrete",
      "type": "all_of",
      "label": "Discrete Math",
      "from_set": "math_discrete",
      "must_be": { "grading_basis": "graded", "min_grade": "B-" }
    },

    {
      "id": "cs313_required",
      "type": "all_of",
      "label": "CS 313 Requirement",
      "from_set": "cs_upper_core_required",
      "must_be": { "grading_basis": "graded", "min_grade": "C-" }
    },

    {
      "id": "cs_upper_electives",
      "type": "credit_pool",
      "label": "Upper-Division Electives",
      "min_credits": 8,
      "where": { "subject": "CS", "min_number": 300 },
      "exclude_from_set": "cs_upper_core_required",
      "must_be": { "grading_basis": "graded", "min_grade": "C-" }
    }
  ],

  "overlap_rules": [
    { "type": "no_double_counting_default" }
  ]
}
