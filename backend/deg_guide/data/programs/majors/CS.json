{
  "id": "MAJOR_CS",
  "name": "Computer Science Major",
  "sets": {
    "cs_lower_core": ["CS210", "CS211", "CS212", "MATH231", "MATH232"],

    "cs_upper_core": ["CS313", "CS314", "CS315", "CS330", "CS415", "CS422", "CS425"],

    "math_seq_251_252": ["MATH251", "MATH252"],
    "math_seq_261_262": ["MATH261", "MATH262"],
    "math_seq_246_247": ["MATH246", "MATH247"]
    
  },
  "requirements": [
    { 
      "id": "cs_lower_core", "type": "all_of", "from_set": "cs_lower_core" 
    },

    { 
      "id": "cs_upper_core", "type": "all_of", "from_set": "cs_upper_core" 
    },

    { "id": "seq_calc_251_252", "type": "all_of", "courses": ["MATH251", "MATH252"], "must_be": { "grading_basis": "graded" } },
    { "id": "seq_calc_261_262", "type": "all_of", "courses": ["MATH261", "MATH262"], "must_be": { "grading_basis": "graded" } },
    { "id": "seq_calc_246_247", "type": "all_of", "courses": ["MATH246", "MATH247"], "must_be": { "grading_basis": "graded" } },

    { "id": "math_two_course_sequence", "type": "choose_k", "k": 1,
      "from_requirements": ["seq_calc_251_252", "seq_calc_261_262", "seq_calc_246_247"]
    },

    {
      "id": "cs_upper_div_elective",
      "type": "credit_pool",
      "min_credits": 20,
      "where": { "subject": "CS", "min_number": 300 },
      "exclude_from_set": "cs_upper_core",
      "constraints": [
        { "min_credits": 12, "where": { "subject": "CS", "min_number": 410 }, "where_attempt": { "grading_basis": "graded" } },
        { "max_credits": 8,  "where": { "subject": "CS", "min_number": 300, "max_number": 409 } },
        { "max_credits": 8,  "where_attempt": { "grading_basis": "pnp" } }
      ]
    }
 
  ],

  "overlap_rules": [
    { "type": "no_double_counting_default" }
  ]
}