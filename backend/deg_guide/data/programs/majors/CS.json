{
  "id": "MAJOR_CS",
  "name": "Computer Science Major (MVP)",
  "sets": {
    "cs_core_lower": ["CS210", "CS211", "CS212"],

    "cs_core_upper": ["CS313", "CS314", "CS315", "CS330", "CS415", "CS422", "CS425"],

    "cs_math_core": [
      "MATH231",
      "MATH232",
      "MATH251",
      "MATH252",
      "MATH341",
      "MATH343",
      "MATH345M"
    ],

    "ethics_options": ["PHIL223", "PHIL123"],

    "writing_options": ["WR320", "WR321", "HC301H"],

    "science_biology_sequence": [
      "BI221Z",
      "BI222Z",
      "BI223Z"
    ],

    "science_earth_sequence": [
      "ERTH201",
      "ERTH202",
      "ERTH203"
    ],

    "science_physics_sequence_a": [
      "PHYS201",
      "PHYS202",
      "PHYS203"
    ],

    "science_physics_sequence_b": [
      "PHYS251",
      "PHYS252",
      "PHYS253"
    ]
  },

  "requirements": [
    {
      "id": "cs_core_lower",
      "type": "all_of",
      "from_set": "cs_core_lower"
    },

    {
      "id": "cs_core_upper",
      "type": "all_of",
      "from_set": "cs_core_upper"
    },

    {
      "id": "math_core",
      "type": "choose_k",
      "k": 4,
      "from_set": "cs_math_core"
    },

    {
      "id": "ethics",
      "type": "choose_k",
      "k": 1,
      "from_set": "ethics_options"
    },

    {
      "id": "writing",
      "type": "choose_k",
      "k": 1,
      "from_set": "writing_options"
    },

    {
      "id": "science_sequence",
      "type": "choose_k",
      "k": 1,
      "options": [
        { "type": "all_of", "from_set": "science_biology_sequence" },
        { "type": "all_of", "from_set": "science_earth_sequence" },
        { "type": "all_of", "from_set": "science_physics_sequence_a" },
        { "type": "all_of", "from_set": "science_physics_sequence_b" }
      ]
    },

    {
      "id": "cs_upper_div",
      "type": "credits_at_least",
      "min_credits": 12,
      "where": {
        "subject": "CS",
        "min_number": 300
      }
    }
  ],

  "overlap_rules": [
    { "type": "no_double_counting_default" }
  ]
}

