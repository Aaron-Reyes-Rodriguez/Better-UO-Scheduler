    { "id": "bridge_requirement", "type": "choose_k", "label": "Bridge Requirement", "user_choice": true, "k": 1, "from_requirements": ["bridgeA_total", "bridgeB_total", "bridgeC_total"] },

    { "id": "fund_analysis", "type": "all_of", "label": "Fundamentals of Analysis", "from_set": "fund_analysis" },
    { "id": "fund_numtheory", "type": "all_of", "label": "Fundamentals of Number Theory", "from_set": "fund_numtheory" },
    { "id": "fund_absalg", "type": "all_of", "label": "Fundamentals of Abstract Algebra", "from_set": "fund_absalg" },
    { "id": "fundamentals_requirement", "type": "choose_k", "label": "Fundamentals Requirement", "user_choice": true, "k": 1, "from_requirements": ["fund_analysis", "fund_numtheory", "fund_absalg"] },

    {
      "id": "upper_electives",
      "type": "credit_pool",
      "label": "Upper-Division Electives",
      "min_credits": 16,
      "from_set": "math_electives_menu",
      "constraints": [
        {
          "type": "min_complete_sequences",
          "min_sequences": 1,
          "sequences": [
            ["MATH316", "MATH317"], ["MATH347", "MATH348"], ["MATH351", "MATH352"],
            ["MATH391", "MATH392"], ["MATH421M", "MATH422"], ["MATH431", "MATH432"],
            ["MATH444", "MATH445"], ["MATH461", "MATH462"]
          ]
        }
      ]
    },

    {
      "id": "math_track_standard",
      "type": "all_of",
      "label": "Standard Track",
      "from_requirements": ["cs122", "bridge_requirement", "fundamentals_requirement", "upper_electives"]
    },

    {
      "id": "math_track",
      "type": "choose_k",
      "label": "Track Selection",
      "k": 1,
      "from_requirements": ["math_track_standard"]
    },

    {
      "id": "math_major",
      "type": "all_of",
      "label": "Math Major",
      "from_requirements": ["calc3", "sv_calc", "lin_alg", "math_track"]
    }
