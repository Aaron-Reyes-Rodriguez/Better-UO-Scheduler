    "math_electives_menu": [
      "MATH316", "MATH317", "MATH320", "MATH343", "MATH345M", "DSCI345M",
      "MATH347", "MATH348", "MATH351", "MATH352", "MATH391", "MATH392",
      "MATH394", "MATH395", "MATH397", "MATH411", "MATH412", "MATH413",
      "MATH414", "MATH415", "MATH421M", "MATH422", "MATH431", "MATH432",
      "MATH433", "MATH441", "MATH444", "MATH445", "MATH446", "MATH456",
      "MATH458", "MATH461", "MATH462", "MATH463", "MATH467"
