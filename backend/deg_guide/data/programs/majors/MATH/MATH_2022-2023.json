    { "id": "lin_alg", "type": "all_of", "label": "Linear Algebra", "from_set": "math_lin_alg" },
    { "id": "cs122", "type": "all_of", "label": "CS 122 (Programming)", "from_set": "cs_prog" },

    { "id": "bridgeA_core", "type": "all_of", "label": "Bridge A - Core", "from_set": "bridgeA_core" },
    { "id": "bridgeA_labs", "type": "choose_k", "label": "Bridge A - Labs", "from_set": "math_labs_201_206", "k": 2 },
    { "id": "bridgeA_total", "type": "all_of", "label": "Bridge A", "from_requirements": ["bridgeA_core", "bridgeA_labs"] },

    { "id": "bridgeB_core", "type": "all_of", "label": "Bridge B - Core", "from_set": "bridgeB_core" },
    { "id": "bridgeB_labs", "type": "choose_k", "label": "Bridge B - Labs", "from_set": "math_labs_201_206", "k": 2 },
    { "id": "bridgeB_total", "type": "all_of", "label": "Bridge B", "from_requirements": ["bridgeB_core", "bridgeB_labs"] },

    { "id": "bridgeC_core", "type": "all_of", "label": "Bridge C - Core", "from_set": "bridgeC_core" },
    { "id": "bridgeC_labs", "type": "choose_k", "label": "Bridge C - Labs", "from_set": "math_labs_201_206", "k": 4 },
